# A server for trying Spoolframe on nimble against the household PMS.
#
#   devenv shell -- cargo run --release -p spoolframe-server -- --config dev.ucl
#   devenv shell -- cargo run --release -p spoolframe-server -- --config dev.ucl setup
#
# Run from this directory: state_dir is relative to it, and .dev-state/ is
# ignored by git. Ports 7430/7431, so it can run beside a server on the
# defaults (7420/7421).
schema = "spoolframe.server.v1";
name = "Nimble";
state_dir = ".dev-state";

plex {
  # fulcrum's PMS; LAN clients need no token.
  url = "http://192.168.86.176:32400";
  # fulcrum's /slow/media, mounted read-only here.
  path_mapping = [ { from = "/slow/media"; to = "/mnt/plex-media"; } ];
  # Mirror andoriyu's watch state with the Plex owner's (PX-04). Check
  # the first run with `… -- --config dev.ucl plex sync-watch --dry-run`.
  watch_sync { user = "andoriyu"; }
}

network { port = 7430; }
admin { listen = "127.0.0.1:7431"; }
