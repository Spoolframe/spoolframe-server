+int ff_hevc_annexb_has_parameter_sets(const uint8_t *buf, int size)
+{
+    const uint8_t *end = buf + size;
+    const uint8_t *nal = ff_nal_find_startcode(buf, end);
+    int found = 0;
+
+    while (nal < end) {
+        int type;
+        while (nal < end && !*(nal++));
+        if (nal >= end)
+            break;
+        type = (*nal >> 1) & 0x3f;
+        if (type < 32)
+            break;
+        if (type <= 34)
+            found |= 1 << (type - 32);
+        nal = ff_nal_find_startcode(nal, end);
+    }
+    return found == 7;
+}
