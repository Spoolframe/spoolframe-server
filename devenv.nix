{
  pkgs,
  lib,
  ...
}: let
  # dx, the dioxus crate and wasm-bindgen move together or not at all: dx
  # refuses to bundle on a mismatch. Named versions (nix/dioxus-cli), so a
  # bump is a change here rather than a surprise (as scribe learnt).
  dioxusPackages = pkgs.callPackage ./nix/dioxus-cli/package.nix {};
  # The web UI's fonts (the design's: Outfit, Figtree, JetBrains Mono,
  # Bricolage Grotesque), from nixpkgs so the bundle carries them and a
  # LAN without the Internet renders the pages as designed.
  webFonts = pkgs.google-fonts.override {
    fonts = ["Outfit" "Figtree" "JetBrains Mono" "Bricolage Grotesque"];
  };
  # The upright variable files only, under the names
  # crates/spoolframe-web/src/app/mod.rs' @font-face rules name.
  webFontsCopy = fonts: ''
    t="${fonts}/share/fonts/truetype"
    d=crates/spoolframe-web/assets/fonts
    install -m 644 "$t/Outfit[wght].ttf" "$d/Outfit.ttf"
    install -m 644 "$t/Figtree[wght].ttf" "$d/Figtree.ttf"
    install -m 644 "$t/JetBrainsMono[wght].ttf" "$d/JetBrainsMono.ttf"
    install -m 644 "$t/BricolageGrotesque[opsz,wdth,wght].ttf" "$d/BricolageGrotesque.ttf"
  '';
in {
  # Stable Rust from rust-overlay (devenv.yaml). llvm-tools-preview is what
  # cargo-llvm-cov instruments with in ci:test; wasm32 is spoolframe-web's
  # target.
  languages.rust = {
    enable = true;
    channel = "stable";
    components = ["rustc" "cargo" "clippy" "rustfmt" "rust-analyzer" "llvm-tools-preview"];
    targets = ["wasm32-unknown-unknown"];
  };

  # Link with clang + mold from this shell's nixpkgs, so CI links exactly as
  # a developer's shell does. Keyed by the host triple so wasm32 keeps its
  # own linker; Linux only (mold does not emit Mach-O). LINKER is mkForce:
  # devenv's languages.rust.clangLinker sets the same variable to a clang
  # pinned to lld. Nix package builds do not see this.
  env =
    {
      # The OCR tests draw text with ffmpeg's drawtext, which needs a font
      # file; fontconfig finds none in the shell.
      SPOOLFRAME_TEST_FONT = "${pkgs.dejavu_fonts}/share/fonts/truetype/DejaVuSans.ttf";
      # scripts/gen-licenses.py reads the web fonts' name tables here: their
      # licenses and copyrights, as the bundle carries them.
      SPOOLFRAME_WEB_FONTS = "${webFonts}/share/fonts/truetype";
    }
    // lib.optionalAttrs pkgs.stdenv.hostPlatform.isLinux (let
      triple = pkgs.stdenv.hostPlatform.rust.cargoEnvVarTarget;
    in {
      "CARGO_TARGET_${triple}_LINKER" = lib.mkForce "${pkgs.clang}/bin/clang";
      "CARGO_TARGET_${triple}_RUSTFLAGS" = lib.mkDefault "-C link-arg=--ld-path=${pkgs.mold}/bin/mold";
    });

  # nextest's profiles. `ci` keeps going past a failure and writes the
  # JUnit report CI publishes (target/nextest/ci/junit.xml). Generated, not
  # committed (.gitignore).
  files.".config/nextest.toml".text = ''
    # nextest configuration, generated by devenv.nix.
    # https://nexte.st/docs/configuration/

    [profile.default]
    test-threads = "num-cpus"

    [profile.ci]
    test-threads = "num-cpus"
    fail-fast = false
    status-level = "all"

    [profile.ci.junit]
    # Relative to target/nextest/<profile>/
    path = "junit.xml"
    report-name = "tests"
  '';

  # uclicious -> uclicious-libucl-sys links libucl via pkg-config, so the
  # server crates need these at build/link time.
  packages = with pkgs; [
    cargo-deny
    cargo-outdated
    jq
    pkg-config
    libucl
    # webauthn-rs (passkeys, P3-05) verifies signatures with OpenSSL.
    openssl
    # ffprobe, which the server runs on every media file it serves (P1-06),
    # and ffmpeg: the package's, with libplacebo (PGPU-04), so the tone map
    # tests run here as they run on a host.
    (callPackage ./nix/ffmpeg.nix {})
    # Reads bitmap subtitles as text (P2-07); English is what the tests
    # read.
    (tesseract.override {enableLanguages = ["eng"];})
    # The LAN tests (P1-13) run in a private network namespace: unshare
    # makes it, ip brings up loopback with multicast.
    util-linux
    iproute2
    # The web UI (P3-01): `dx bundle`, its wasm-bindgen, and Tailwind.
    (dioxusPackages."0.7.10".override {wasm-bindgen-version = "0.2.126";})
    dioxusPackages.wasm-bindgen-versions."0.2.126"
    tailwindcss_4
    # wasm-opt, which dx runs on the release bundle.
    binaryen
    # scripts/gen-licenses.py, the open source license list.
    python3
  ];

  # spoolframe-web/assets/tailwind.css is generated and committed (dx
  # bundles it as an asset); a stale one renders the page with class names
  # and no rules behind them, which looks like a styling bug, not a stale
  # file (scribe's FD-488).
  tasks = {
    "spoolframe:licenses" = {
      description = "Check server and public SDK license boundaries";
      exec = "bash scripts/check-licenses.sh";
    };
    # The admin pages' Open source licenses read a committed list
    # (crates/spoolframe-web/assets/licenses.json); it fails here when
    # Cargo.lock or the web app's assets moved without it.
    "spoolframe:licenses-list" = {
      description = "Check the open source license list is current";
      exec = "python3 scripts/gen-licenses.py --check";
    };
    "ci:static".after = ["spoolframe:licenses" "spoolframe:licenses-list"];
    "spoolframe:tailwind-fresh" = {
      description = "The committed Tailwind stylesheet matches a fresh build";
      exec = ''
        set -euo pipefail
        built="$(mktemp -t tailwind-fresh.XXXXXX.css)"
        trap 'rm -f "$built"' EXIT
        tailwindcss -i crates/spoolframe-web/input.css -o "$built" >/dev/null 2>&1
        if ! diff -q "$built" crates/spoolframe-web/assets/tailwind.css >/dev/null; then
          echo "crates/spoolframe-web/assets/tailwind.css is stale. Regenerate it:" >&2
          echo "  tailwindcss -i crates/spoolframe-web/input.css -o crates/spoolframe-web/assets/tailwind.css" >&2
          diff -u crates/spoolframe-web/assets/tailwind.css "$built" | head -40 >&2
          exit 1
        fi
      '';
    };
    # Additive: ci:style (the ci profile below) keeps the rustfmt check.
    "ci:style".after = ["spoolframe:tailwind-fresh"];

    # The fonts the bundle carries, into the asset folder the app embeds
    # (ignored by git: they come from nixpkgs).
    "spoolframe:fonts" = {
      description = "Copy the web UI's fonts into crates/spoolframe-web/assets/fonts";
      exec = ''
        set -euo pipefail
        ${webFontsCopy webFonts}
      '';
    };

    # The web UI's bundle, for `cargo run --features embed-web` with
    # SPOOLFRAME_WEB_DIST=target/dx/spoolframe-web/release/web/public. A
    # debug server reads that directory as it is, so bundle and reload.
    "spoolframe:web" = {
      description = "Build the web UI bundle (Tailwind, then dx bundle)";
      exec = ''
        set -euo pipefail
        ${webFontsCopy webFonts}
        tailwindcss -i crates/spoolframe-web/input.css -o crates/spoolframe-web/assets/tailwind.css
        rm -rf target/dx/spoolframe-web/release/web/public
        WASM_BINDGEN="$(command -v wasm-bindgen)" \
          dx bundle --package spoolframe-web --platform web --release --profile wasm-release
      '';
    };
  };

  # The web UI's dev loop (`devenv up`): a debug server without
  # `embed-web` takes every page from dx serve on 127.0.0.1:8080 (the port
  # crates/spoolframe-server/src/web/dev_server.rs names) and tunnels its
  # hot-reload socket, so the browser only ever opens the admin listener.
  # Tailwind runs beside it: dx does not build the stylesheet.
  processes = {
    web.exec = ''
      set -euo pipefail
      ${webFontsCopy webFonts}
      export WASM_BINDGEN="$(command -v wasm-bindgen)"
      exec dx serve --package spoolframe-web --platform web --port 8080 \
        --hot-reload true --watch true --open false --interactive false
    '';
    tailwind.exec = "exec tailwindcss -i crates/spoolframe-web/input.css -o crates/spoolframe-web/assets/tailwind.css --watch=always";
  };

  # CI's phases: `devenv --profile ci tasks run ci:static ci:style ci:test`
  # (.forgejo/workflows/ci.yaml runs exactly these). The tools they call
  # live in the profile, so a plain `devenv shell` stays lean.
  # Coldsteel's own infrastructure: crates.io through the kellnr proxy on
  # cargo.coldsteel.casa, and kache, the shared compiler cache in the
  # Garage bucket. Not for anyone else's machine: CI extends it, and so does
  # the user's own account on every machine (profiles.user.andoriyu), so a
  # public checkout never touches either.
  profiles.coldsteel.module = {pkgs, ...}: let
    kacheConfig = (pkgs.formats.toml {}).generate "kache.toml" {
      cache.remote = {
        type = "s3";
        bucket = "kache";
        endpoint = "https://s3.coldsteel.casa";
        region = "garage";
      };
    };
  in {
    packages = [pkgs.kache];
    env = {
      RUSTC_WRAPPER = "kache";
      KACHE_CONFIG = "${kacheConfig}";
    };
    # The mirror is a cargo config file: cargo does not read [source.*]
    # from environment variables (tested). It goes in cargo's home, never
    # the repo (cargo publish wants a clean tree), and a home config that
    # already replaces crates.io is left alone. kache's Garage credentials
    # are rendered by vault-agent on hosts and runners; without them kache
    # caches locally only.
    enterShell = ''
      cargo_home="''${CARGO_HOME:-$HOME/.cargo}"
      if ! grep -qs '^\[source.crates-io\]' "$cargo_home/config.toml"; then
        mkdir -p "$cargo_home"
        cat >> "$cargo_home/config.toml" <<'TOML'
      [source.crates-io]
      replace-with = "coldsteel-mirror"

      [source.coldsteel-mirror]
      registry = "sparse+https://cargo.coldsteel.casa/api/v1/cratesio/"
      TOML
      fi
      unset cargo_home
      kache_env="''${KACHE_CREDENTIALS_FILE:-/run/kache/s3.env}"
      if [ -r "$kache_env" ]; then
        set -a
        . "$kache_env"
        set +a
      fi
      unset kache_env
    '';
  };
  profiles.user.andoriyu.extends = ["coldsteel"];
  # The dev server on nimble, against the household PMS: `devenv up nimble`
  # builds the web bundle and a release server with it embedded, then runs
  # it with its state in .dev-state/ (ignored by git). Not started by a
  # plain `devenv up`, the web UI's dev loop. Once it is up,
  # `devenv tasks run spoolframe:nimble-setup` registers the first admin.
  #
  # LAN only: IPv4, no relays, no pkarr record and no `wan` section, so
  # nothing outside the home reaches it; HTTP playback serves LAN clients
  # only, with no `address` set. No watch sync with Plex.
  profiles.user.andoriyu.module = {pkgs, ...}: let
    nimbleConfig = pkgs.writeText "nimble.ucl" ''
      schema = "spoolframe.server.v1";
      name = "Nimble";

      plex {
        # fulcrum's PMS; LAN clients need no token.
        url = "http://192.168.86.176:32400";
        # fulcrum's /slow/media, mounted read-only here.
        path_mapping = [ { from = "/slow/media"; to = "/mnt/plex-media"; } ];
      }

      network {
        # 7430/7431, beside a server on the defaults (7420/7421).
        port = 7430;
        ipv6 = false;
        relays = [];
        pkarr = "off";
      }

      # insecure_cookies: sign in over plain HTTP from the LAN; the session
      # cookie loses Secure (it keeps HttpOnly). localhost is where web
      # passkeys work: WebAuthn refuses an IP address over plain HTTP.
      admin {
        listen = "0.0.0.0:7431";
        insecure_cookies = true;
        public_url = "http://localhost:7431";
        not_proxied = true;
      }

      # Optimized versions (PX-37): binge-ahead is off by default. 16 GiB
      # on nimble: its root disk is shared with the build dirs and has
      # filled before.
      optimized {
        binge_ahead = true;
        max_size_mb = 16384;
      }

      # The rest of what grows under .dev-state, kept small for the same
      # disk: live transcodes' scratch (20 GiB by default) and frame
      # previews (4 GiB by default).
      transcode {
        scratch_limit_mb = 8192;
      }
      previews {
        cache_mb = 2048;
      }

      # Downloads (PX-38): 16 GiB on nimble too, for the same reason.
      downloads {
        max_size_mb = 16384;
      }

      # HTTP playback (PX-49), for AirPlay tests from the apps.
      http_playback {
        listen = "[::]:7422";
      }

      # Traces to nimble's Alloy (yard), which sends them on to Tempo.
      telemetry {
        otlp {
          endpoint = "http://127.0.0.1:4317";
          protocol = "grpc";
          traces = true;
          metrics = false;
          logs = false;
        }
      }
    '';
  in {
    tasks."spoolframe:nimble-build" = {
      description = "Build the release server with the web bundle embedded";
      exec = ''
        set -euo pipefail
        ${webFontsCopy webFonts}
        tailwindcss -i crates/spoolframe-web/input.css -o crates/spoolframe-web/assets/tailwind.css
        rm -rf target/dx/spoolframe-web/release/web/public
        WASM_BINDGEN="$(command -v wasm-bindgen)" \
          dx bundle --package spoolframe-web --platform web --release --profile wasm-release
        # rust-embed reads the bundle at compile time and cargo does not see
        # it change: without this, a web-only change embeds the old pages.
        touch crates/spoolframe-server/src/web.rs
        SPOOLFRAME_WEB_DIST="$PWD/target/dx/spoolframe-web/release/web/public" \
          cargo build --release -p spoolframe-server --features embed-web
      '';
    };

    processes.nimble = {
      start.enable = false;
      after = ["spoolframe:nimble-build"];
      exec = ''
        set -euo pipefail
        mkdir -p .dev-state
        # The log is kept for spoolframe:nimble-setup, which reads the
        # setup code from it.
        exec > >(tee -a .dev-state/server.log) 2>&1
        exec target/release/spoolframe-server --config ${nimbleConfig} --state-dir .dev-state
      '';
    };

    # The first admin, `andoriyu`, with a generated password kept in
    # .dev-state/admin-password (made once, readable by the owner only).
    tasks."spoolframe:nimble-setup" = {
      description = "Register the dev server's first admin";
      exec = ''
        set -euo pipefail
        umask 077
        pw=.dev-state/admin-password
        [ -s "$pw" ] || python3 -c 'import secrets; print(secrets.token_urlsafe(18), end="")' >"$pw"
        code="$(grep -o 'the setup code is [A-Z0-9-]*' .dev-state/server.log | tail -1 | awk '{print $NF}')"
        if [ -z "$code" ]; then
          echo "no setup code in .dev-state/server.log: is the server up, with no users yet?" >&2
          exit 1
        fi
        target/release/spoolframe-server --config ${nimbleConfig} --state-dir .dev-state \
          setup --code "$code" --username andoriyu --password-stdin <"$pw"
        echo "admin andoriyu, password in $pw"
      '';
    };
  };

  profiles.ci.extends = ["coldsteel"];
  profiles.ci.module = {pkgs, ...}: {
    # devenv's automatic cachix setup fails under a pure flake eval and an
    # untrusted runner user; substituters are configured on the runner host.
    cachix.enable = lib.mkForce false;

    packages = with pkgs; [
      cargo-nextest
      cargo-llvm-cov
      cargo-audit
    ];

    tasks = {
      "ci:style" = {
        description = "Check formatting with rustfmt";
        exec = "cargo fmt --all -- --check";
      };
      # Host clippy never builds the web app: it is wasm only. The wasm
      # pass keeps it (and its tests) compiling, as scribe's ci:static
      # does after it once collected errors nobody saw.
      "ci:static" = {
        description = "Clippy, host and wasm32, warnings denied";
        exec = ''
          set -euo pipefail
          cargo clippy --locked --workspace --all-targets -- -D warnings
          cargo clippy --locked --target wasm32-unknown-unknown -p spoolframe-web --all-targets -- -D warnings
        '';
      };
      # JUnit (nextest's ci profile) at target/nextest/ci/junit.xml and lcov
      # at target/lcov.info; the workflow publishes both. CI splits the
      # suite over jobs: NEXTEST_PARTITION (e.g. count:1/3) runs only
      # that share of the tests, and each job's lcov covers only its share.
      # nextest has no environment variable for --partition, hence this one.
      # Unset, the whole suite runs, as it does on a workstation.
      # Coverage is of this repo's code only: lines a dependency's macro
      # expands into (tokio's select!) otherwise land in the lcov under the
      # registry's path in CARGO_HOME, which the report step cannot read.
      "ci:test" = {
        description = "Tests with nextest under llvm-cov (JUnit + lcov)";
        exec = ''
          cargo llvm-cov nextest --locked --profile ci --no-tests=warn \
            ''${NEXTEST_PARTITION:+--partition "$NEXTEST_PARTITION"} \
            --ignore-filename-regex '/\.cargo/(registry|git)/|/rustc/' \
            --lcov --output-path target/lcov.info
        '';
      };
      # CI builds the tests once, instrumented, into a nextest archive
      # (ci:test-archive, about 420 MB), and three jobs each run a third of
      # it from the archive with no compiling (ci:test-shard). A shard has
      # only the archive and a checkout: --workspace-remap points the
      # tests' paths at the checkout, and llvm-cov-target must exist before
      # the archive is extracted into it.
      "ci:test-archive" = {
        description = "Build the instrumented tests into target/tests.tar.zst";
        exec = "cargo llvm-cov nextest-archive --locked --archive-file target/tests.tar.zst";
      };
      "ci:test-shard" = {
        description = "Run NEXTEST_PARTITION of target/tests.tar.zst (JUnit + lcov)";
        exec = ''
          mkdir -p target/llvm-cov-target
          status=0
          cargo llvm-cov nextest --archive-file target/tests.tar.zst \
            --workspace-remap . --profile ci --no-tests=warn --no-report \
            ''${NEXTEST_PARTITION:+--partition "$NEXTEST_PARTITION"} || status=$?
          # The lcov of what ran, failed tests or not; the job fails after.
          cargo llvm-cov report --nextest-archive-file target/tests.tar.zst \
            --ignore-filename-regex '/\.cargo/(registry|git)/|/rustc/' \
            --lcov --output-path target/lcov.info
          exit "$status"
        '';
      };
      "ci:audit" = {
        description = "Audit dependencies for known vulnerabilities";
        # Both lockfiles: the fuzz targets are a workspace of their own.
        exec = "cargo audit && cargo audit --file fuzz/Cargo.lock";
      };
      "ci:doc" = {
        description = "Build documentation";
        exec = "cargo doc --no-deps --all-features";
      };
    };
  };

  enterShell = ''
    echo "spoolframe dev environment"
  '';
}
