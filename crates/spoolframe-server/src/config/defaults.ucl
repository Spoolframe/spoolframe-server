# spoolframe-server's built-in defaults (schema spoolframe.server.v1).
#
# Every setting is here at its default. A setting that is commented out
# has no default value: the comment says what the server does without it.
#
# The server reads three layers, later ones winning key by key:
#
#   1. these defaults, built in (`spoolframe-server config defaults`);
#   2. the provided file, if any: `--config <file>` or SPOOLFRAME_CONFIG;
#   3. runtime.ucl in the state directory, which the server writes when a
#      setting is changed in the web UI or with `config set`. Never edit
#      it by hand: the server rewrites it whole.
#
# A provided file with `locked = true;` locks every key it sets: the web
# UI and `config set` cannot change them. Keys it leaves out stay
# editable.
#
# Where the layers are is not configuration: the state directory comes
# from --state-dir, SPOOLFRAME_STATE_DIR, systemd's $STATE_DIRECTORY,
# $XDG_STATE_HOME/spoolframe, or /var/lib/spoolframe when run as root.
# The key, the database, the caches and runtime.ucl live there.

schema = "spoolframe.server.v1";

# What clients show for this server.
name = "Spoolframe";

# The Plex Media Servers the catalog reads from. Without one the server
# runs "not set up": the web UI and the admin API work, and clients are
# told the server is not set up yet. The setup wizard sets the first.
#
# plex {
#   # The first PMS, on the LAN, never plex.tv: the catalog works without
#   # the Internet. Its id, in `libraries`, is "plex".
#   url = "http://192.168.1.20:32400";
#   # What Spoolframe calls it; the address's host if left out.
#   name = "Tower";
#   # A file holding the X-Plex-Token; none for a PMS that lets LAN
#   # clients in without one. A token set in the web UI is kept in the
#   # state directory instead (secrets/plex-token), never in a config.
#   token_file = "/run/secrets/plex-token";
#   # Rewrites from the paths Plex reports to the paths this host reads,
#   # for every library or, with `library`, for one.
#   path_mapping [
#     { from = "/data/movies"; to = "/mnt/nas/movies"; },
#     { library = "Music"; from = "/data"; to = "/mnt/nas/music"; },
#   ]
#   # Watch state sync with each user's Plex account. Every user links
#   # their own in My profile (Sign in with Plex); `user` links this one
#   # by the config, as the Plex servers' owner, with each server's own
#   # token (or none). While it is set, a library of the first server
#   # that does not say otherwise syncs both ways. Every linked user is
#   # synced every `interval_secs`, and soon after their state changes.
#   watch_sync {
#     user = "andoriyu";
#     interval_secs = 120;
#   }
#   # Further Plex servers, each with an id of its own that never changes:
#   # its items' IDs carry it. A token set in the web UI is kept as
#   # secrets/plex-token-<id>.
#   servers [
#     { id = "cabin"; name = "Cabin"; url = "http://10.0.1.5:32400";
#       token_file = "/run/secrets/plex-cabin";
#       path_mapping [ { from = "/data"; to = "/mnt/cabin"; } ] },
#   ]
# }

# The libraries apps show, in this order, each one library section of a
# Plex server under the name given here. Left out, every library of the
# first Plex server is served under Plex's names. `kind` (movies, shows or
# music) keeps a library listed while its Plex server is down. Removing
# one hides it; watch state is kept for when it is added back. `sync` is
# which way its watch state syncs with each linked user's Plex account:
# off, from_plex, to_plex or both; left out, both for the first server's
# libraries while plex.watch_sync.user is set, else off.
#
# libraries [
#   { name = "Films"; kind = "movies"; plex { server = "plex"; section = "2"; sync = "both"; } },
#   { name = "Cabin movies"; kind = "movies"; plex { server = "cabin"; section = "1"; } },
# ]

# The Iroh endpoint clients connect to.
network {
  # The UDP port. Left out, a free one is picked at every start; fix it
  # when a firewall needs to know.
  # port = 7420;
  # "disabled", "default" (the public relays) or a relay URL. Only
  # "disabled" until remote access.
  relay = "disabled";
  # Announce the server on the LAN over mDNS, so clients find it.
  mdns = true;
}

# The admin API (JSON-RPC over WebSocket) and the web UI.
admin {
  # Every IPv4 interface. Put something that terminates TLS in front of
  # it (nginx, Caddy) and set public_url: over plain HTTP a browser drops
  # the Secure session cookie, and passkeys do not work. "127.0.0.1:7421"
  # for a host whose proxy runs on the same machine.
  listen = "0.0.0.0:7421";
  # Where browsers reach the web UI through a TLS reverse proxy. Its host
  # is what passkeys are bound to. Left out, a browser must be on the
  # listener's own host.
  # public_url = "https://media.example.org";
  # The reverse proxies in front of the listener, as addresses and CIDR
  # ranges, comma-separated. Left out, no X-Forwarded-For is read.
  # trusted_proxies = "10.0.0.5, 172.17.0.0/16";
  # Send the session cookie without Secure and HttpOnly, so signing in
  # over plain HTTP on the LAN works. The cookie then crosses the LAN in
  # clear and page scripts can read it; passkeys still need HTTPS.
  insecure_cookies = false;
  # Answer GET /metrics on this listener with Prometheus text. Off, it is
  # not found.
  metrics = false;
  # The addresses and CIDR ranges a scraper may read it from,
  # comma-separated; anyone else is refused. Behind trusted_proxies, the
  # address the proxy forwards for.
  metrics_from = "127.0.0.0/8, ::1";
}

# Single sign-on (P3-04): OpenID Connect providers a user may link to
# their account in My profile, and then sign in with ("Continue with
# <name>"). A provider never makes accounts: an identity not linked to a
# user is refused. Each needs admin.public_url, since the provider sends
# the browser back to <public_url>/auth/oidc/callback; register that as
# the client's redirect URI, with PKCE, scopes "openid profile email".
# Everything else about a provider (its endpoints, keys, how the client
# authenticates, PKCE) comes from its discovery document, at
# <issuer>/.well-known/openid-configuration, whose issuer must be exactly
# the one configured. Left out, no SSO anywhere.
#
# auth {
#   oidc [
#     { name = "Pocket ID"; issuer = "https://id.example.org";
#       client_id = "…";
#       # A file holding the client secret. Left out, the secret set in
#       # the web UI, kept as secrets/oidc-<name> in the state directory.
#       client_secret_file = "/run/secrets/spoolframe-oidc";
#       # What is asked for; openid is always.
#       scopes = ["openid", "profile", "email"]; },
#   ]
# }

# The artwork cache under the state directory, in MiB.
artwork {
  cache_mb = 1024;
}

# When an item counts as started, and as watched (without credits markers).
watch {
  started_after_secs = 60;
  watched_percent = 95;
}

# The tools the server runs; by default whatever is on PATH.
media {
  ffmpeg = "ffmpeg";
  ffprobe = "ffprobe";
  tesseract = "tesseract";
}

# Converting for clients that cannot play a file as it is.
transcode {
  # "auto" (every family that works), "none" (software only), or
  # families in order of preference: "nvenc,vaapi".
  hardware = "auto";
  vaapi_device = "/dev/dri/renderD128";
  # Encodes at once.
  max_jobs = 2;
  # Where encodes write; the state directory's cache/transcode if left
  # out.
  # scratch_dir = "/var/cache/spoolframe/transcode";
  # The most all encodes may write together, in MiB.
  scratch_limit_mb = 20480;
  # How far an encode may run ahead of its reader.
  read_ahead_secs = 60;
}

# Bitmap subtitles (PGS, VobSub, DVB) read as text with tesseract.
subtitles {
  ocr = true;
  # tesseract processes at once; half the CPUs if left out.
  # ocr_threads = 4;
  # Where the text is kept; the state directory's cache/subtitles if left
  # out.
  # cache_dir = "/var/cache/spoolframe/subtitles";
}

# Frame previews for scrubbing: a picture every interval_secs of each film
# and episode, made in the background at the lowest CPU and I/O priority.
# Where a Plex server already made its own preview index for a file, it is
# read from Plex instead.
previews {
  # "ahead": for every file, newest and in-progress first, until the cache
  # is full, and at once for anything played; "on_play": only for what is
  # played; "never": none, and clients show the time alone.
  when = "ahead";
  interval_secs = 10;
  # The most the previews under the state directory's cache/previews may
  # take, in MiB; the least recently used go first. A two-hour film's are
  # a few MiB.
  cache_mb = 4096;
  # Files made ahead at once, only while nothing is being encoded: they
  # wait while an encode runs, and go on where they were when it ends.
  # What is played, or asked for, is made at once, encodes or not. The
  # physical cores the server may use if left out.
  # workers = 8;
}
