# spoolframe-server's built-in defaults (schema spoolframe.server.v1).
#
# Every setting is here at its default. A setting that is commented out
# has no default value: the comment says what the server does without it.
#
# The server reads three layers, later ones winning key by key:
#
#   1. these defaults, built in (`spoolframe-server config defaults`);
#   2. the provided file, if any: `--config <file>` or SPOOLFRAME_CONFIG;
#   3. runtime.ucl in the state directory, which the server writes when a
#      setting is changed in the web UI or with `config set`. Never edit
#      it by hand: the server rewrites it whole.
#
# A provided file with `locked = true;` locks every key it sets: the web
# UI and `config set` cannot change them. Keys it leaves out stay
# editable.
#
# SIGHUP (`systemctl reload`, `spoolframe-server config reload`) has a
# running server read the provided file and runtime.ucl again. They are
# checked as at start; if they do not load, nothing changes and the log
# says why. Live settings apply at once; the others, the ones the web UI
# marks "after a restart", at the next start.
#
# Where the layers are is not configuration: the state directory comes
# from --state-dir, SPOOLFRAME_STATE_DIR, systemd's $STATE_DIRECTORY,
# $XDG_STATE_HOME/spoolframe, or /var/lib/spoolframe when run as root.
# The key, the database, the caches and runtime.ucl live there.

schema = "spoolframe.server.v1";

# What clients show for this server.
name = "Spoolframe";

# The Plex Media Servers the catalog reads from. Without one the server
# runs "not set up": the web UI and the admin API work, and clients are
# told the server is not set up yet. The setup wizard sets the first.
#
# plex {
#   # The first PMS, on the LAN, never plex.tv: the catalog works without
#   # the Internet. Its id, in `libraries`, is "plex".
#   url = "http://192.168.1.20:32400";
#   # What Spoolframe calls it; the address's host if left out.
#   name = "Tower";
#   # A file holding the X-Plex-Token; none for a PMS that lets LAN
#   # clients in without one. A token set in the web UI is kept in the
#   # state directory instead (secrets/plex-token), never in a config.
#   token_file = "/run/secrets/plex-token";
#   # Rewrites from the paths Plex reports to the paths this host reads,
#   # for every library or, with `library`, for one.
#   path_mapping [
#     { from = "/data/movies"; to = "/mnt/nas/movies"; },
#     { library = "Music"; from = "/data"; to = "/mnt/nas/music"; },
#   ]
#   # Watch state sync with each user's Plex account. Every user links
#   # their own in My profile (Sign in with Plex); `user` links this one
#   # by the config, as the Plex servers' owner, with each server's own
#   # token (or none). While it is set, a library of the first server
#   # that does not say otherwise syncs both ways. Every linked user is
#   # synced every `interval_secs`, and soon after their state changes.
#   watch_sync {
#     user = "andoriyu";
#     interval_secs = 120;
#   }
#   # Further Plex servers, each with an id of its own that never changes:
#   # its items' IDs carry it. A token set in the web UI is kept as
#   # secrets/plex-token-<id>.
#   servers [
#     { id = "cabin"; name = "Cabin"; url = "http://10.0.1.5:32400";
#       token_file = "/run/secrets/plex-cabin";
#       path_mapping [ { from = "/data"; to = "/mnt/cabin"; } ] },
#   ]
# }

# The libraries apps show, in this order, each one library section of a
# Plex server under the name given here. Left out, every library of the
# first Plex server is served under Plex's names. `kind` (movies, shows or
# music) keeps a library listed while its Plex server is down. Removing
# one hides it; watch state is kept for when it is added back. `sync` is
# which way its watch state syncs with each linked user's Plex account:
# off, from_plex, to_plex or both; left out, both for the first server's
# libraries while plex.watch_sync.user is set, else off.
#
# libraries [
#   { name = "Films"; kind = "movies"; plex { server = "plex"; section = "2"; sync = "both"; } },
#   { name = "Cabin movies"; kind = "movies"; plex { server = "cabin"; section = "1"; } },
# ]

# The Iroh endpoint clients connect to.
network {
  # The UDP port. Left out, a free one is picked at every start; fix it
  # when a firewall needs to know.
  # port = 7420;
  # Listen on IPv6 too. Off, the server listens on IPv4 only, so no
  # device reaches it over IPv6, directly or by hole punching. On, it
  # tells devices every global IPv6 address the host has, temporary
  # (privacy) ones included.
  ipv6 = true;
  # The relays the server may take its home relay from: a list of
  # "default" (n0's public relays) and relay URLs, as
  # ["default", "https://relay.example.com"]. Devices that cannot dial the
  # server directly reach it through its home relay, and invites carry the
  # list. Empty: relays off, the server reached only on the LAN or at a
  # public address.
  relays = [];
  # Optional, and only for one case: a device that knows the server's
  # identity (from an invite or an earlier sign-in) but no longer knows an
  # address that reaches it, as when your public IP changed while it was
  # away. Then the server publishes a record of where it is, signed with
  # its key, and devices look it up by that key. You do not need it on
  # the LAN, with a public address that does not change, or with relays
  # on: devices that know the server's relays reach it through them.
  # "off" (the default), "n0" (n0's public service, dns.iroh.link), or
  # the URL of your own pkarr relay (an iroh-dns-server's /pkarr). The
  # record is public: it holds the relays and public addresses only,
  # never a LAN one.
  pkarr = "off";
  # Announce the server on the LAN over mDNS, so clients find it.
  mdns = true;
  # The UDP port the setup wizard's search for Plex servers on the LAN
  # (Plex's GDM) is sent from. Each Plex server answers to it, and a host
  # firewall drops those answers unless the port is open: it cannot match
  # them to a search sent to a multicast group. Not one of Plex's own
  # ports (32410-32414). 0 is any free port, whose answers a firewall
  # drops. A port another program holds is given up for any free one,
  # with a warning in the log.
  plex_discovery_port = 32415;
  # The most connections held at once from devices that are not signed
  # in: new devices signing in, and anyone else who finds the port. One
  # more is refused until one goes. A signed-in device is always let in.
  max_stranger_connections = 64;
  # How long a request may take to arrive once a client opens a stream
  # for it. A stream that sends nothing in time is reset.
  first_frame_timeout_secs = 10;
  # How long a media or artwork stream may wait for its reader to take
  # any more of it. One left unread is reset: it holds a file open.
  stalled_read_secs = 120;
  # The addresses a signed-in device is told to dial the server at. The
  # server has an address on each network interface, and container and
  # VM bridges are on that list too: no device reaches those, and on most
  # devices 172.17.0.1 is their own docker0. Told are the addresses on
  # `interfaces` (each interface when empty, but the virtual ones:
  # "docker*", "br-*", "veth*" and "virbr*"), less those on
  # `ignore_interfaces`, less those in `ignore`, plus `add`. A virtual
  # interface is told only when `interfaces` names it ("docker0"). An
  # `add` address is told even when an ignore matches it. Interface names
  # take `*` and `?`. A change applies at the next start; the interfaces
  # are read each time the list is worked out. `spoolframe-server status`
  # shows the list told now.
  announce {
    # Addresses the server does not see itself, for example the public
    # address of a NAT that forwards the port: "203.0.113.7" (with the
    # server's port) or "203.0.113.7:7420".
    add = [];
    # Addresses and CIDR ranges never told: "172.17.0.0/16", "10.0.0.9".
    ignore = [];
    # Interfaces never told, even when `interfaces` names them: ["wg1"].
    # The virtual ones need not be listed.
    ignore_interfaces = [];
    # When set, only these interfaces' addresses are told:
    # ["enp*", "wg0"]. Naming a virtual one tells it: ["enp*", "docker0"].
    interfaces = [];
  }
  # The server's public addresses: the ones a device off the LAN dials.
  # Left out, as here, none is advertised, and devices reach the server
  # on the LAN. Present, each part below adds addresses to what a
  # signed-in device is told, and the status page lists each one with
  # where it came from. Only public addresses: a private, loopback,
  # link-local, carrier-grade NAT (100.64.0.0/10) or unique local one is
  # refused. Nothing here waits at start: a router that refuses, or a
  # lookup that fails, is one line in the log and a note on the status
  # page. A change applies at the next start.
  # wan {
  #   # Public addresses with their port, told as written. The forward is
  #   # yours to set up: ["203.0.113.7:7420", "[2001:db8::1]:7420"].
  #   static = [];
  #   # One address made of the port forwarded on the router and this
  #   # network's public IP. On, with these defaults, whenever `wan` is
  #   # present; `mapped_port = false;` turns it off.
  #   mapped_port {
  #     # "auto": the server asks the router to forward its own port
  #     # (UPnP, NAT-PMP or PCP) and renews it; the address and port the
  #     # router reports are told. "manual": you forwarded the port.
  #     mode = "auto";
  #     # The public port forwarded in "manual" mode; network.port if left
  #     # out.
  #     # port = 7420;
  #     # This network's public IP, or "lookup": asked of `lookup_via`
  #     # once at start. In "auto" mode it is used only when the router
  #     # reports an address that is not a public one (a router behind
  #     # carrier-grade NAT).
  #     public_ip = "lookup";
  #     # Where "lookup" asks: "wtfismyip" (https://ipv4.wtfismyip.com/text),
  #     # or false: never ask, and public_ip must be an address.
  #     lookup_via = "wtfismyip";
  #   }
  # }
}

# The admin API (JSON-RPC over WebSocket) and the web UI.
admin {
  # Every IPv4 interface: for browsers on the LAN, or a proxy on another
  # host, named in trusted_proxies. Over plain HTTP a browser drops the
  # Secure session cookie, and passkeys do not work, so put something
  # that terminates TLS in front of it (nginx, Caddy) and set public_url.
  # With the proxy on this host, listen on loopback and name the proxy:
  #   listen = "127.0.0.1:7421";
  #   public_url = "https://media.example.org";
  #   trusted_proxies = ["127.0.0.1"];
  # The proxy connects from loopback, so without trusted_proxies every
  # caller through it would look like loopback.
  listen = "0.0.0.0:7421";
  # Where browsers reach the web UI through a TLS reverse proxy. Its host
  # is what passkeys are bound to. Left out, a browser must reach the
  # listener by its address or as localhost: a name could be anyone's
  # (DNS rebinding).
  # public_url = "https://media.example.org";
  # The reverse proxies in front of the listener, as addresses and CIDR
  # ranges, comma-separated. Left out, no X-Forwarded-For is read.
  # trusted_proxies = ["10.0.0.5", "172.17.0.0/16"];
  # A loopback listen with a public_url means a proxy on this host, and
  # the server refuses to start without trusted_proxies: every caller
  # would look like loopback. On every interface with a public_url there
  # may be one, and the server warns at start without trusted_proxies.
  # Set this only when nothing proxies to the listener (an SSH tunnel,
  # browsers that reach it directly).
  not_proxied = false;
  # Send the session cookie without Secure, so signing in over plain
  # HTTP on the LAN works. The cookie then crosses the LAN in clear, but
  # stays HttpOnly; passkeys still need HTTPS. Refused while public_url
  # is https.
  insecure_cookies = false;
  # Answer GET /metrics on this listener with Prometheus text. Off, it is
  # not found.
  metrics = false;
  # The addresses and CIDR ranges a scraper may read it from, a list;
  # anyone else is refused. Behind trusted_proxies, the
  # address the proxy forwards for.
  metrics_from = ["127.0.0.0/8", "::1"];
}

# Single sign-on (P3-04): OpenID Connect providers a user may link to
# their account in My profile, and then sign in with ("Continue with
# <name>"). A provider never makes accounts: an identity not linked to a
# user is refused. Each needs admin.public_url, since the provider sends
# the browser back to <public_url>/auth/oidc/callback; register that as
# the client's redirect URI, with PKCE, scopes "openid profile email".
# Everything else about a provider (its endpoints, keys, how the client
# authenticates, PKCE) comes from its discovery document, at
# <issuer>/.well-known/openid-configuration, whose issuer must be exactly
# the one configured. Left out, no SSO anywhere.
#
auth {
  # oidc [
  #   { name = "Pocket ID"; issuer = "https://id.example.org";
  #     client_id = "…";
  #     # The client secret, first found first: a file holding it; or
  #     # client_secret, best as an environment variable the server
  #     # reads, ${SF_ENV_<NAME>} (this file is plain text, and the
  #     # runtime layer takes nothing but such a reference); or, with
  #     # neither, the secret pasted in the web UI, kept unencrypted as
  #     # secrets/oidc-<name> in the state directory.
  #     client_secret_file = "/run/secrets/spoolframe-oidc";
  #     # client_secret = "${SF_ENV_OIDC_SECRET}";
  #     # What is asked for; openid is always.
  #     scopes = ["openid", "profile", "email"]; },
  # ]

  # Trusted devices (P4-01): a device a user chose to remember opens
  # their profile without a password. Unused for this many days (1 to
  # 3650), it forgets them, and they sign in again in full.
  trust_idle_days = 180;
}

# The artwork cache under the state directory, in MiB.
artwork {
  cache_mb = 1024;
}

# When an item counts as started, and as watched (without credits markers).
watch {
  started_after_secs = 60;
  watched_percent = 95;
}

# The tools the server runs; by default whatever is on PATH.
media {
  ffmpeg = "ffmpeg";
  ffprobe = "ffprobe";
  tesseract = "tesseract";
  # They read files anyone who can write to a library made. "required"
  # confines each run with Landlock and a seccomp filter (no network, no
  # state directory, only its own files), or refuses to start; "auto"
  # does when this kernel has Landlock (Linux 6.2 or later), and otherwise
  # runs them with the seccomp filter alone and an error in the log; "off"
  # never confines them. Their environment is cleared and their memory,
  # CPU time and file sizes are limited either way.
  sandbox = "auto";
}

# Converting for clients that cannot play a file as it is.
transcode {
  # The GPUs encodes run on, in order of preference. Each entry is an api
  # ("nvenc", "vaapi" or "qsv") and either pick or device:
  #   pick = "all"   every card of that API, the most capable first, a
  #                  job going to the next when one is full (the default);
  #   pick = "best"  the most capable card alone;
  #   pick = "dgpu"  discrete cards only; pick = "igpu" integrated ones;
  #   device = …     exactly one card: a CUDA index for NVIDIA (0, 1, …,
  #                  as nvidia-smi numbers them), a render node for VA-API
  #                  and QSV ("/dev/dri/by-path/pci-0000:03:00.0-render").
  # max_jobs = n bounds the GPU video encodes on each of the entry's cards
  # (max_gpu_jobs if left out). Each video encode runs on one card: the
  # one that does the most of it (decoding the source and running its
  # filters too), then the entries' order deciding. Left out, every card
  # of every API, as:
  # gpus = [
  #   { api = "nvenc"; pick = "all"; },
  #   { api = "vaapi"; pick = "all"; },
  #   { api = "qsv"; pick = "all"; },
  # ];
  # [] is no GPU: software only.
  #
  # Deprecated, and not with gpus: hardware ("auto", "none", or families
  # in order: ["nvenc", "vaapi"]) and vaapi_device (VA-API's one render
  # node) are read as the gpus they mean: each family every card of it,
  # VA-API on vaapi_device alone when that is set.
  # hardware = "auto";
  # vaapi_device = "/dev/dri/renderD128";
  # The encode budget: how many software video encodes (libx264) run at
  # once. Lighter conversions take less of it: a GPU video encode half of
  # one, or a quarter when it is decoded and scaled on the GPU too with
  # nothing on the CPU; an audio-only encode (the video copied) a quarter;
  # a remux (every stream copied) none. A conversion that does not fit is refused as
  # busy; the same device's idle conversions give way first.
  max_jobs = 2;
  # Remuxes at once. They cost next to no CPU, but each holds the file
  # open and writes to the scratch directory.
  max_remux = 32;
  # GPU video encodes (VA-API, NVENC) at once on each GPU, within the
  # budget too; a gpus entry's max_jobs overrides it for its cards.
  max_gpu_jobs = 3;
  # Where encodes write; the state directory's cache/transcode if left
  # out.
  # scratch_dir = "/var/cache/spoolframe/transcode";
  # The most all encodes may write together, in MiB.
  scratch_limit_mb = 20480;
  # How far an encode may run ahead of its reader.
  read_ahead_secs = 60;
  # Run a GPU encode's filters on the GPU, where it can: faster and
  # lighter on the CPU, though colours or subtitle placement may differ
  # slightly. VA-API tone maps HDR (tonemap_vaapi) and burns in picture
  # subtitles (overlay_vaapi) where the driver can (Mesa has neither);
  # NVIDIA scales (scale_cuda) and burns in picture subtitles
  # (overlay_cuda), and tone maps on the CPU, its whole chain with it.
  # What the GPU cannot, and text subtitles, the CPU does as when this
  # is off. The tone map is tone_map's.
  gpu_filters = false;
  # How HDR is tone mapped to SDR for a screen that shows no HDR:
  # "auto" uses the job's GPU's own tone map (tonemap_vaapi, Intel) while
  # gpu_filters is on, else libplacebo on the job's GPU through Vulkan
  # (AMD, NVIDIA) whatever gpu_filters says, else the CPU. "cpu", "gpu" (the
  # driver's own) or "libplacebo" forces one, whatever gpu_filters says;
  # a job whose GPU cannot run it is tone mapped on the CPU.
  tone_map = "auto";
  # The codecs a GPU encodes to, the first preferred: "av1", "hevc",
  # "h264". A conversion takes the first one the client plays (decodes in
  # hardware, where it says) and a GPU here encodes with room. An HDR film
  # for a screen that shows HDR keeps it, in HEVC or AV1 at 10 bits,
  # rather than being tone mapped: the tone map is what a conversion of
  # HDR costs, not the codec. With no codec left, the conversion is
  # encoded in software, which is H.264 only (libx264). [] keeps video
  # off the GPUs.
  video_codecs = ["av1", "hevc", "h264"];
}

# Offer bitmap subtitles (PGS, VobSub, DVB) as text, read with tesseract.
# Each user picks text or pictures in their track preferences; off, every
# user gets pictures.
subtitles {
  ocr = true;
  # tesseract processes at once; half the CPUs if left out.
  # ocr_threads = 4;
  # Where the text is kept; the state directory's cache/subtitles if left
  # out.
  # cache_dir = "/var/cache/spoolframe/subtitles";
}

# Frame previews for scrubbing: a picture every interval_secs of each film
# and episode, made in the background at the lowest CPU and I/O priority.
# Where a Plex server already made its own preview index for a file, it is
# read from Plex instead.
previews {
  # "ahead": for every file, newest and in-progress first, until the cache
  # is full, and at once for anything played; "on_play": only for what is
  # played; "never": none, and clients show the time alone.
  when = "ahead";
  interval_secs = 10;
  # The most the previews under the state directory's cache/previews may
  # take, in MiB; the least recently used go first. A two-hour film's are
  # a few MiB.
  cache_mb = 4096;
  # Files made ahead at once, only while nothing is being encoded: they
  # wait while an encode runs, and go on where they were when it ends.
  # What is played, or asked for, is made at once, encodes or not. The
  # physical cores the server may use if left out.
  # workers = 8;
}

# The last log lines kept in memory for the web UI's Logs page, at the
# level the server logs at: what the journal has, nothing more.
logs {
  buffer_lines = 5000;
}

# OpenTelemetry export: the server's spans, log records and metrics over
# OTLP, to a collector (an OpenTelemetry Collector, Grafana Alloy). Off
# without an endpoint. A live setting. What is exported never carries a
# token or a secret, and names users only as local:<uuid>.
telemetry {
  otlp {
    # "http://alloy.lan:4317" for gRPC; "http://alloy.lan:4318" for HTTP,
    # to which /v1/traces, /v1/metrics and /v1/logs are added.
    # endpoint = "http://alloy.lan:4317";
    # "grpc" or "http" (protobuf).
    protocol = "grpc";
    # Sent with every export, a table of header name to value; never
    # logged.
    # headers { x-scope-orgid = "home"; }
    traces = true;
    metrics = true;
    logs = true;
  }
}

# Switches that may change or go away in any release, without notice. The
# server logs the ones set at start.
experimental {
  # On an AMD GPU, libplacebo's tone map uses ffmpeg's Vulkan device, so
  # the frames stay on the GPU, rather than one of its own, which takes
  # them through system memory. Tried at start, and its own used where
  # that fails, as it does with Mesa's RADV today. NVIDIA always shares.
  libplacebo_shared_on_amd = false;
}
